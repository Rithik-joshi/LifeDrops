
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum ContactMethod {
  EMAIL
  PHONE
}

enum RequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role            @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  donorProfile  DonorProfile?
  bloodRequests BloodRequest[]
  responses     DonorResponse[]
}

model DonorProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  bloodGroup       BloodGroup
  city             String
  state            String
  isAvailable      Boolean       @default(true)
  isDiscoverable   Boolean       @default(false)
  lastDonationDate DateTime?
  preferredContact ContactMethod @default(EMAIL)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bloodGroup, city])
  @@index([isDiscoverable, isAvailable])
}

model BloodRequest {
  id                String        @id @default(cuid())
  requesterId       String
  bloodGroup        BloodGroup
  city              String
  state             String
  hospitalName      String
  requiredDate      DateTime
  unitsRequired     Int
  contactPreference ContactMethod
  additionalDetails String?
  status            RequestStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  requester User            @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  responses  DonorResponse[]

  @@index([bloodGroup, city, status])
  @@index([status, requiredDate])
}

model DonorResponse {
  id        String         @id @default(cuid())
  requestId String
  donorId   String
  message   String?
  status    ResponseStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  request BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor   User         @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorId])
  @@index([donorId])
}
